<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="camera_world">

    <!-- Core Gazebo systems -->
    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>

    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>

    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>

    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <ambient>0.3 0.3 0.3 1</ambient>
    <background>0.8 0.9 1 1</background>
    <!-- Basic light -->
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>1 1 1 1</specular>
      <direction>-0.5 0.5 -1</direction>
    </light>
    <!-- Sun -->

    <!-- Ground -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
            </plane>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>1.0 1.0 1.0 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/bookshelf</uri>
      <pose>-0.8 0 0 0 0 1.57</pose>
    </include>
    <!-- Small box 1 -->
    <model name="shelf_box_1">
      <static>true</static>
      <pose>-0.66 0.25 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 0.1 0.15</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 0.1 0.15</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>


    <!-- Small box 2 -->
    <model name="shelf_box_2">
      <static>true</static>
      <pose>-0.5 -0.165 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 0.2 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 0.2 0.1</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Small box 3 -->
    <model name="shelf_box_3">
      <static>true</static>
      <pose>-0.5 -0.125 0.9 0 0 0.86</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 0.2 0.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 0.2 0.2</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>
    <!-- Small box 4 -->
    <model name="shelf_box_4">
      <static>true</static>
      <pose>-0.5 0.3 0.95 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.06 0.06 0.3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.06 0.06 0.3</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Desk -->
    <model name="desk">
      <static>true</static>
      <pose>0.8 0 0.4 0 0 0</pose>

      <link name="desk_link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.2 0.8 0.8</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.2 0.8 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

    <!-- Box obstacle -->
    <model name="box">
      <static>false</static>
      <pose>0.5 0.3 0.9 0 0 0</pose>

      <link name="box_link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.2 1 1</ambient>
            <diffuse>0.1 0.2 1 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

  </world>
</sdf>