<?xml version="1.0"?>
<robot name="ur5e_rgbd" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- arguments forwarded from launch -->
  <xacro:arg name="ur_type" default="ur5e"/>
  <xacro:arg name="name" default="ur"/>
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="safety_limits" default="true"/>
  <xacro:arg name="safety_pos_margin" default="0.15"/>
  <xacro:arg name="safety_k_position" default="20"/>
  <xacro:arg name="sim_ignition" default="true"/>
  <xacro:arg name="simulation_controllers" default=""/>

  <!-- include UR robot (this already instantiates the robot) -->
  <xacro:include filename="$(find ur_description)/urdf/ur.urdf.xacro"/>

  <!-- include RealSense -->
  <xacro:include filename="$(find realsense2_description)/urdf/_d435.urdf.xacro"/>

  <!-- camera mount -->
  <link name="realsense_mount"/>

  <joint name="realsense_mount_joint" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="realsense_mount"/>
    <origin xyz="0.08 0.0 -0.02" rpy="0 -1.86 0"/>
  </joint>

  <!-- camera -->
  <xacro:sensor_d435 parent="realsense_mount" name="camera">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:sensor_d435>
    <!-- Gazebo RGBD sensor -->
  <gazebo reference="realsense_mount">
    <sensor name="rgbd_camera" type="rgbd_camera">
      <update_rate>30</update_rate>

      <camera>
        <horizontal_fov>1.047</horizontal_fov>

        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>

        <clip>
          <near>0.1</near>
          <far>10</far>
        </clip>
      </camera>

      <depth_camera>
        <clip>
          <near>0.1</near>
          <far>5</far>
        </clip>
      </depth_camera>

      <always_on>true</always_on>
      <visualize>true</visualize>

    </sensor>
  </gazebo>

</robot>