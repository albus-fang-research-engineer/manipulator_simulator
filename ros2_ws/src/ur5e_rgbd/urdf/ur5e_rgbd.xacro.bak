<?xml version="1.0"?>
<robot name="ur5e_rgbd" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Declare arguments that the launcher passes -->
  <xacro:arg name="ur_type" default='ur5e'>
  <!-- <xacro:arg name="prefix"/>
  <xacro:arg name="safety_limits"/>
  <xacro:arg name="safety_pos_margin"/>
  <xacro:arg name="safety_k_position"/>
  <xacro:arg name="name"/> -->

  <!-- Load the real UR robot -->
  <xacro:include filename="$(find ur_description)/urdf/ur.urdf.xacro"/>

  <!-- Attach camera to wrist -->
  <link name="rgbd_camera_link">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0"
               iyy="1e-6" iyz="0"
               izz="1e-6"/>
    </inertial>
  </link>

  <joint name="rgbd_camera_joint" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="rgbd_camera_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo RGBD camera -->
  <gazebo reference="rgbd_camera_link">
    <sensor name="rgbd_camera" type="rgbd_camera">
      <update_rate>30</update_rate>

      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10</far>
        </clip>
      </camera>

      <depth_camera>
        <clip>
          <near>0.1</near>
          <far>5</far>
        </clip>
      </depth_camera>

    </sensor>
  </gazebo>

</robot>